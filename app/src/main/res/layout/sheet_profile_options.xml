<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/profile_options_title"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/profileNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Default" />

    <TextView
        android:id="@+id/profileStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        tools:text="Current listening profile" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/useProfileButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pill_button_accent"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="@string/use_profile"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/renameButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_button_white"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="@string/rename_profile"
        android:textAllCaps="false"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/deleteButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_outlined_button"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="@string/delete_profile"
        android:textAllCaps="false"
        android:textColor="@color/urgency_critical_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
