<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_echo_logo" />

            <TextView
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="echoAI" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/historyButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/history"
            android:padding="9dp"
            android:src="@drawable/ic_clock"
            app:tint="@color/muted" />
    </LinearLayout>

    <!-- Scene chips -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sceneChipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp"
        android:scrollbars="none" />

    <!-- Radar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="8dp">

        <com.echoai.ui.RadarView
            android:id="@+id/radarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Floating Start/Listening pill button -->
    <LinearLayout
        android:id="@+id/liveToggleContainer"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- IMU rotate hint: shown when audio is active but the phone is held still. -->
        <TextView
            android:id="@+id/rotateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_pinned_banner"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/rotate_hint"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/liveToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button_accent"
            android:drawableStart="@drawable/ic_mic"
            android:drawablePadding="10dp"
            android:drawableTint="@color/white"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:stateListAnimator="@null"
            android:text="@string/start_live"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status line (kept for accessibility / debugging — visually subtle) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text="@string/live_idle"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Pinned alerts section -->
    <LinearLayout
        android:id="@+id/pinnedAlertsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/missed_alerts"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clearAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:text="@string/clear_all"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pinnedAlertsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingEnd="8dp"
                android:scrollbarSize="3dp"
                android:scrollbars="vertical" />

            <View
                android:id="@+id/pinnedAlertsScrollIndicator"
                android:layout_width="4dp"
                android:layout_height="42dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pinned_scroll_indicator"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom tab bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borderMed" />

    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tabBar"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/tabListening"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/tabListeningIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_echo_logo" />

            <TextView
                android:id="@+id/tabListeningLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_listening"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/tabProfileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_people"
                app:tint="@color/muted" />

            <TextView
                android:id="@+id/tabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_scene_profile"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/systemNavBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/systemNavBar" />

</LinearLayout>
