<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pinned_banner"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/urgencyStrip"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:minHeight="64dp" />

    <FrameLayout
        android:id="@+id/iconCircle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_info" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/labelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Fire Alarm" />

            <TextView
                android:id="@+id/urgencyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_urgency_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.07"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAllCaps="true"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="CRITICAL" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:textColor="@color/muted"
            android:textSize="12sp"
            tools:text="Detected 3 times · 2:15 PM" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dismissButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dismiss"
        android:padding="10dp"
        android:src="@drawable/ic_close" />

</LinearLayout>
