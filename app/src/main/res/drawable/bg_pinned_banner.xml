<?xml version="1.0" encoding="utf-8"?>
<!-- Background of a pinned banner. Tint set programmatically per urgency. The border is
     applied as a stroke at runtime by replacing the drawable with a GradientDrawable
     (so we can use the per-urgency border color). This file is the fallback shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#FFFFFF" />
</shape>
