<?xml version="1.0" encoding="utf-8"?>
<!-- Urgency badge background. PinnedAlertAdapter / SoundEventAdapter / HistoryAdapter
     tint this drawable per-row using urgency.tintBackground; the stroke is overlaid via
     a separate setter or kept neutral here. Corner radius matches the design (5dp). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="5dp" />
    <solid android:color="#FFFFFFFF" />
</shape>
